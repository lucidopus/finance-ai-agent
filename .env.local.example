# MongoDB Connection
# Required for database operations
MONGODB_URI=mongodb://localhost:27017/finance-ai-agent

# LandingAI API Key
# Required for document extraction (ADE)
# Get your API key from: https://landing.ai/
LANDING_AI_API_KEY=your_landing_ai_api_key_here

# Anthropic API Key (Optional)
# Required only if ENABLE_LLM_FALLBACK=true
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Fallback Configuration (Optional)
# Set to 'true' to enable Claude fallback when ADE extraction is low-confidence
# This will incur additional API costs but improves extraction accuracy
ENABLE_LLM_FALLBACK=false

# Next.js Configuration
# Public URL for API callbacks (optional in development)
NEXT_PUBLIC_API_URL=http://localhost:3000

# File Storage Configuration (Future)
# STORAGE_TYPE=local|vercel_blob|s3
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# VERCEL_BLOB_READ_WRITE_TOKEN=your-vercel-token
